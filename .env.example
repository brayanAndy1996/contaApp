SIRE_CLIENT=mock
SOL_PORTAL=mock
RUC_CLIENT=mock
XML_PROVIDER=mock
KEY_PROVIDER=mock
STORAGE=mock
# Servicios locales (docker-compose.yml, spec 019): pnpm servicios:up
# Contraseña de PostgreSQL de desarrollo (solo local). Si cambias un puerto, cambia también su URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=contapp_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Superusuario: solo para db:migrate y db:seed
MIGRATIONS_DATABASE_URL=postgresql://postgres:contapp_dev@localhost:5432/contapp
# Rol de la app: la contraseña es obligatoria; db:migrate la fija en la BD con la de esta URL
DATABASE_URL=postgresql://contapp_app:contapp_app_dev@localhost:5432/contapp
REDIS_URL=redis://localhost:6379
KEK_ID=mock
KEK_PUBLIC_KEY_PATH=./secrets/kek-public.pem
# Solo apps/worker (en local: apps/worker/.env)
KEK_PRIVATE_KEY_PATH=./secrets/kek-private.pem
# Autenticación (004)
APP_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:4000
PORT=4000
TRUST_PROXY=loopback
CORREO_PROVIDER=consola
# remitente de los correos (lo usa CORREO_PROVIDER=smtp)
CORREO_REMITENTE=
# solo con CORREO_PROVIDER=smtp; en local, Mailpit (sin credenciales)
SMTP_URL=smtp://localhost:1025
# Argon2id: piso 19456 KiB / 2 / 1; por debajo, error de arranque
ARGON2_MEMORIA_KIB=19456
ARGON2_ITERACIONES=2
ARGON2_PARALELISMO=1
# Adaptadores (009): solo existe `mock`; otro valor falla el arranque del worker. Ausente = mock
# Con NODE_ENV=production y algún adaptador en mock el worker no arranca, salvo con esta variable (registra un aviso)
# PERMITIR_ADAPTADORES_MOCK=1
# Carpeta de fixtures XML del mock (por defecto fixtures/xml del repo) y latencia simulada por llamada, en ms
# XML_FIXTURES_DIR=
# XML_MOCK_LATENCIA_MS=0
# Storage de XML (016): mock (memoria; en producción exige PERMITIR_ADAPTADORES_MOCK=1) o local (archivos bajo STORAGE_DIR)
STORAGE_DIR=./storage
# XML simulado en las reglas (016, P-4): con 1, el XML de mock cuenta para R-MIX y R-ISC. Por defecto el código la toma como 0
XML_SIMULADO_EN_REGLAS=1

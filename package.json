{
  "name": "contapp",
  "version": "1.0.0",
  "scripts": {
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @contapp/db db:migrate",
    "db:seed": "pnpm --filter @contapp/db db:seed",
    "test:aislamiento": "pnpm --filter @contapp/tests-aislamiento test:aislamiento",
    "cobertura:db": "pnpm --filter @contapp/db build && pnpm --filter @contapp/db test:cobertura",
    "cobertura:crypto": "pnpm --filter @contapp/db build && pnpm --filter @contapp/crypto build && pnpm --filter @contapp/crypto test:cobertura",
    "ci:db": "pnpm db:migrate && pnpm db:migrate && pnpm db:seed && pnpm test:aislamiento && pnpm --filter @contapp/worker test:int"
  },
  "packageManager": "pnpm@10.12.1",
  "private": true,
  "engines": {
    "node": ">=24.1.0 <25",
    "pnpm": ">=10.12.1 <11"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}

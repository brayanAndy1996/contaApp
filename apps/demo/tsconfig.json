{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": {
      "@contapp/domain": ["../../packages/domain/src/index.ts"],
      "@contapp/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}

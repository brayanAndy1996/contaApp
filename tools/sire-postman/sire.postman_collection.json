      "description": "Ruta del servicio 5.40 (manual RCE v28), después de /v1/contribuyente/migeigv/libros/, sin / inicial. Vacía hasta que la copies del manual."
    }
  ],
  "item": [
    {
      "name": "0. Obtener token",
      "auth": {
        "type": "noauth"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "if (r.access_token) {",
              "  // Se guarda como 'current value' del entorno (local, no se sincroniza si no lo compartes).",
              "  pm.environment.set('sire_token', r.access_token);",
              "  const seg = Number(r.expires_in || 3600);",
              "  pm.environment.set('sire_token_expira', String(Date.now() + (seg - 60) * 1000));",
              "  console.log('Token OK. Tipo:', r.token_type, '| expira en (s):', seg, '| campos:', Object.keys(r).join(', '));",
              "} else {",
              "  console.log('Sin access_token. Campos de la respuesta:', Object.keys(r).join(', '));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "scope",
              "value": "https://api-sire.sunat.gob.pe"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}"
            },
            {
              "key": "username",
              "value": "{{ruc}}{{usuario_sol}}",
              "description": "RUC + usuario SOL pegados, sin espacio"
            },
            {
              "key": "password",
              "value": "{{clave_sol}}"
            }
          ]
        },
        "url": {
          "raw": "https://api-seguridad.sunat.gob.pe/v1/clientessol/{{client_id}}/oauth2/token/",
          "protocol": "https",
          "host": [
            "api-seguridad",
            "sunat",
            "gob",
            "pe"
          ],
          "path": [
            "v1",
            "clientessol",
            "{{client_id}}",
            "oauth2",
            "token",
            ""
          ]
        },
        "description": "Servicio 5.1 Api Seguridad. La respuesta contiene el token: no la compartas ni la pegues en chats."
      }

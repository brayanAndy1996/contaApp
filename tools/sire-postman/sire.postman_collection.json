{
  "info": {
    "name": "ContApp · SIRE (solo lectura)",
    "description": "Banco de pruebas de las APIs SIRE de SUNAT (Compras RCE v28 y Ventas RVIE v30). SOLO LECTURA: token, periodos, descargar propuesta, consultar ticket y descargar archivo (más 5.51 y 5.40 para el registro presentado, P-3 de la spec 041). No incluye aceptar/reemplazar/registrar/eliminar. Ver README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{sire_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Avisa si el token no existe o ya venció (no lo pide solo: ejecuta '0. Obtener token').",
          "if (pm.info.requestName.startsWith('0.')) return;",
          "const exp = Number(pm.environment.get('sire_token_expira') || 0);",
          "if (!pm.environment.get('sire_token') || Date.now() > exp) console.warn('Token SIRE ausente o vencido: ejecuta primero \"0. Obtener token\".');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "rce_ticket",
      "value": ""
    },
    {
      "key": "rce_codProceso",
      "value": ""
    },
    {
      "key": "rce_perTributario",
      "value": ""
    },
    {
      "key": "rce_nomArchivoReporte",
      "value": ""
    },
    {
      "key": "rce_codTipoArchivoReporte",
      "value": ""
    },
    {
      "key": "rvie_ticket",
      "value": ""
    },
    {
      "key": "rvie_codProceso",
      "value": ""
    },
    {
      "key": "rvie_perTributario",
      "value": ""
    },
    {
      "key": "rvie_nomArchivoReporte",

        {
          "name": "3. Consultar estado del ticket (RCE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const t = pm.collectionVariables.get('rce_ticket');",
                  "const reg = (r.registros || []).find(x => x.numTicket === t) || (r.registros || [])[0];",
                  "if (!reg) { console.log('Sin registros para el ticket', t); return; }",
                  "console.log('Estado:', reg.codEstadoProceso, reg.desEstadoProceso, '| proceso', reg.codProceso, reg.desProceso);",
                  "const arch = (reg.archivoReporte || [])[0];",
                  "pm.collectionVariables.set('rce_codProceso', reg.codProceso || '');",
                  "pm.collectionVariables.set('rce_perTributario', reg.perTributario || '');",
                  "if (arch) {",
                  "  pm.collectionVariables.set('rce_nomArchivoReporte', arch.nomArchivoReporte || '');",
                  "  pm.collectionVariables.set('rce_codTipoArchivoReporte', arch.codTipoAchivoReporte ?? arch.codTipoArchivoReporte ?? 'null');",
                  "  console.log('Archivo listo:', arch.nomArchivoReporte, '(', (reg.archivoReporte || []).length, 'archivo(s) )');",
                  "} else { console.log('Aún no hay archivo: vuelve a consultar en unos segundos.'); }"
                ]
              }
            }

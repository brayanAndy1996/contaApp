{
  "name": "@contapp/domain",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:cobertura": "vitest run --config vitest.cobertura.config.mts --coverage --passWithNoTests"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "vitest": "5.0.5"
  }
}

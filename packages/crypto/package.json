{
  "name": "@contapp/crypto",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./descifrado": {
      "types": "./dist/descifrado.d.ts",
      "default": "./dist/descifrado.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:cobertura": "vitest run --config vitest.cobertura.config.mts --coverage --passWithNoTests",
    "kek:generar": "node dist/cli/kek-generar.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
